<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Metadatos del ejecutable -->
    <AssemblyTitle>Sistema de Evaluación de Madurez Tecnológica</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Angelo Rivero</Company>
    <Product>MadurezTecnologica</Product>
    <Copyright>© 2026 Angelo Rivero</Copyright>

    <!-- Compresión para reducir tamaño del exe final -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Icono del ejecutable y de la ventana principal -->
    <ApplicationIcon>Recursos\Iconos\app.ico</ApplicationIcon>

    <!-- Manifest (para longPathAware y declaración de compatibilidad con Windows). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- DPI-awareness gestionado por WinForms (.NET 8+). PerMonitorV2 = escalado
         nítido en monitores con 125/150/200% de escala y respuesta al mover la
         ventana entre pantallas de distinta densidad. WinForms se encarga de
         propagar la config al runtime; no hace falta SetHighDpiMode en código. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- appconfi.json se EMBEBE dentro del ejecutable (recurso embebido), para que el
         .exe single-file funcione solo, sin necesitar el archivo de config al lado.
         Configuracion.cs lo lee del recurso embebido si no encuentra el archivo. -->
    <None Remove="appconfi.json" />
    <EmbeddedResource Include="appconfi.json" />

    <!-- Iconos PNG embebidos: los lee CargadorIconos desde recursos embebidos, para
         que el .exe single-file siga funcionando solo, sin archivos externos. -->
    <None Remove="Recursos\Iconos\app.png" />
    <None Remove="Recursos\Iconos\inicio.png" />
    <None Remove="Recursos\Iconos\empresas.png" />
    <None Remove="Recursos\Iconos\cargar_informe.png" />
    <None Remove="Recursos\Iconos\chat.png" />
    <None Remove="Recursos\Iconos\resultados.png" />
    <None Remove="Recursos\Iconos\historial.png" />
    <None Remove="Recursos\Iconos\analizar.png" />
    <None Remove="Recursos\Iconos\word.png" />
    <None Remove="Recursos\Iconos\pdf.png" />
    <EmbeddedResource Include="Recursos\Iconos\app.png" />
    <EmbeddedResource Include="Recursos\Iconos\inicio.png" />
    <EmbeddedResource Include="Recursos\Iconos\empresas.png" />
    <EmbeddedResource Include="Recursos\Iconos\cargar_informe.png" />
    <EmbeddedResource Include="Recursos\Iconos\chat.png" />
    <EmbeddedResource Include="Recursos\Iconos\resultados.png" />
    <EmbeddedResource Include="Recursos\Iconos\historial.png" />
    <EmbeddedResource Include="Recursos\Iconos\analizar.png" />
    <EmbeddedResource Include="Recursos\Iconos\word.png" />
    <EmbeddedResource Include="Recursos\Iconos\pdf.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Recursos\Logos\" />
    <Folder Include="Recursos\Iconos\" />
  </ItemGroup>

</Project>